{
  "name": "media-ripper",
  "version": "1.0.0",
  "description": "YouTube media downloader — audio, video, playlists",
  "main": "server/index.js",
  "bin": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
